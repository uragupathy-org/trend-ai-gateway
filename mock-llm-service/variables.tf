variable "kubeconfig_path" {
  description = "Kubeconfig generated by k3s-deploy."
  type        = string
  default     = "../k3s-deploy/generated/k3s-aigateway-kubeconfig.yaml"
}

variable "kube_context" {
  description = "Context inside the kubeconfig."
  type        = string
  default     = "k3s-aigateway"
}

variable "namespace" {
  description = "Existing namespace where the gateway runs."
  type        = string
  default     = "trendai-gateway"
}

variable "port" {
  description = "Port the mock server listens on (also the Service port)."
  type        = number
  default     = 8001
}

variable "image" {
  description = "Container image that provides python3."
  type        = string
  default     = "python:3.12-alpine"
}
