#!/bin/bash
# Installs a single-node k3s server. Rendered by Terraform (templatefile).
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y curl ca-certificates

# --tls-san adds the Elastic IP to the API server certificate so kubectl from
# the local Mac validates the connection without skipping TLS verification.
curl -sfL https://get.k3s.io | INSTALL_K3S_EXEC="server --write-kubeconfig-mode 644 --tls-san ${eip} --node-name ${node_name}" sh -
